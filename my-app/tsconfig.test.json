{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "erasableSyntaxOnly": false,
    "types": ["jest", "node"],
    "lib": ["ES2020", "DOM"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test/setupTests.ts",
    "src/types/**/*.d.ts"
  ]
}
